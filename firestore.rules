rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to read/write their own bookings
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         request.auth.token.email == 'isabel.sparkes@hotmail.com');
    }
    
    // Allow users to read/write messages for their bookings
    match /messages/{messageId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.senderId || 
         request.auth.token.email == 'isabel.sparkes@hotmail.com' ||
         exists(/databases/$(database)/documents/bookings/$(resource.data.bookingId)) &&
         get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.userId == request.auth.uid);
    }
    
    // Allow admin to read/write activity logs
    match /activityLog/{logId} {
      allow read, write: if request.auth != null && 
        request.auth.token.email == 'isabel.sparkes@hotmail.com';
    }
  }
}